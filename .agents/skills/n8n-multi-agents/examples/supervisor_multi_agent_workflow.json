{
  "name": "Supervisor Multi-Agent Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "multi-agent-orchestrator",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2a2b3c4d-0001-4000-8000-000000000001",
      "name": "Webhook Input",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 320]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "Você é um orquestrador supervisor. Classifique a intenção do usuário em UMA categoria: 'vendas', 'suporte' ou 'tecnico'. Responda APENAS em JSON válido: { \"categoria\": \"<vendas|suporte|tecnico>\", \"resumo\": \"<resumo em 1 linha>\" }."
        }
      },
      "id": "2a2b3c4d-0002-4000-8000-000000000002",
      "name": "Supervisor Router Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [420, 320]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0
        }
      },
      "id": "2a2b3c4d-0003-4000-8000-000000000003",
      "name": "OpenAI Router Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [420, 520],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "vendas",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ JSON.parse($json.output).categoria }}",
                    "rightValue": "vendas",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "suporte",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ JSON.parse($json.output).categoria }}",
                    "rightValue": "suporte",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "tecnico",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ JSON.parse($json.output).categoria }}",
                    "rightValue": "tecnico",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "2a2b3c4d-0004-4000-8000-000000000004",
      "name": "Route by Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [680, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/agente-vendas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-token",
              "value": "={{ $env.AGENT_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"input\": $('Webhook Input').item.json.body.message, \"session_id\": $('Webhook Input').item.json.body.session_id, \"resumo\": JSON.parse($json.output).resumo } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2a2b3c4d-0005-4000-8000-000000000005",
      "name": "Call Sub-Agent Vendas (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 140]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SUB_WORKFLOW_SUPORTE_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "2a2b3c4d-0006-4000-8000-000000000006",
      "name": "Execute Sub-Agent Suporte",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [960, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/agente-tecnico",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-token",
              "value": "={{ $env.AGENT_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"input\": $('Webhook Input').item.json.body.message, \"session_id\": $('Webhook Input').item.json.body.session_id, \"resumo\": JSON.parse($json.output).resumo } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2a2b3c4d-0007-4000-8000-000000000007",
      "name": "Call Sub-Agent Tecnico (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"output\": $json.output, \"agente\": $json.agente || 'supervisor', \"session_id\": $('Webhook Input').item.json.body.session_id, \"status\": $json.status || 'sucesso' } }}",
        "options": {}
      },
      "id": "2a2b3c4d-0008-4000-8000-000000000008",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1240, 320]
    }
  ],
  "connections": {
    "Webhook Input": {
      "main": [
        [
          {
            "node": "Supervisor Router Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Router Model": {
      "ai_languageModel": [
        [
          {
            "node": "Supervisor Router Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Supervisor Router Agent": {
      "main": [
        [
          {
            "node": "Route by Intent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Intent": {
      "main": [
        [
          {
            "node": "Call Sub-Agent Vendas (HTTP)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Execute Sub-Agent Suporte",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call Sub-Agent Tecnico (HTTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Sub-Agent Vendas (HTTP)": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Sub-Agent Suporte": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Sub-Agent Tecnico (HTTP)": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
